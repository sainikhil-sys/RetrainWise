# Copy this file to .env (never commit .env) and fill in your SMTP account.
# Restart `streamlit run app.py` after changing it, then confirm delivery with:
#     python auth.py --test-email you@example.com

# --- Gmail (needs 2-Step Verification + an App Password: myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
SMTP_FROM=RetrainWise <you@gmail.com>

# --- Outlook / Microsoft 365:   SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURITY=starttls
# --- Zoho:                      SMTP_HOST=smtp.zoho.com       SMTP_PORT=465  SMTP_SECURITY=ssl
# --- SendGrid:                  SMTP_HOST=smtp.sendgrid.net   SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASSWORD=<API key>
#     (SendGrid/Mailgun/SES: SMTP_FROM must be a verified sender or domain, or mail is dropped)
# Port 465 always pairs with SMTP_SECURITY=ssl; port 587 with SMTP_SECURITY=starttls.

# Seconds to wait for the SMTP server.
SMTP_TIMEOUT=20

# Local development only: when SMTP_HOST is empty, show verification codes on screen
# instead of emailing them. Leave this off anywhere real users sign in.
AUTH_DEV_CODES=0
