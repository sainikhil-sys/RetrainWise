# Copy to .env and adjust. `npm run dev` creates .env with safe local defaults
# (DATABASE_URL, AUTH_SECRET, AUTH_URL) when it does not exist yet.

# Application database (Prisma). Local SQLite by default; see README for PostgreSQL.
DATABASE_URL="file:../data/app.db"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"   # e.g. `npx auth secret`
AUTH_URL="http://localhost:3000"                   # public URL in production
SESSION_MAX_AGE_DAYS="7"                           # sessions expire after this many days

# Email (magic links and approval notifications) via Resend.
# Without AUTH_RESEND_KEY, development builds write emails to the local
# outbox at /dev/mailbox instead of sending them. Production requires a key.
AUTH_RESEND_KEY=""
EMAIL_FROM="RetrainWise <no-reply@your-domain.com>"

# Python engine interpreter (optional; auto-detected otherwise)
RETRAINWISE_PYTHON=""

# Comma-separated host names allowed to call the API besides localhost
# (set this when deploying behind a domain, e.g. "retrainwise.example.com").
RETRAINWISE_ALLOWED_HOSTS=""
