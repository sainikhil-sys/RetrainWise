# Copy to .env and adjust. `npm run dev` creates .env with safe local defaults
# (DATABASE_URL, AUTH_SECRET, AUTH_URL) when it does not exist yet.

# Application database (Prisma). Local SQLite by default; see README for PostgreSQL.
DATABASE_URL="file:../data/app.db"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"   # e.g. `npx auth secret`
AUTH_URL="http://localhost:3000"                   # public URL in production
SESSION_MAX_AGE_DAYS="7"                           # sessions expire after this many days

# Option A (no domain needed): send through an SMTP account, e.g. Gmail.
# Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords and paste it below (16 letters).
# When SMTP_HOST is set it is used first; Resend is the fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Option B: Resend (needs a verified sending domain to reach anyone).
# Email (magic links and approval notifications) via Resend.
# Without AUTH_RESEND_KEY, development builds write emails to the local
# outbox at /dev/mailbox instead of sending them. Production requires a key.
AUTH_RESEND_KEY=""
# Sender. "onboarding@resend.dev" works without a domain, but Resend then only
# delivers to the email address that owns the Resend account. To email anyone,
# verify your domain at https://resend.com/domains and use an address on it.
# In development, rejected sends fall back to the local outbox (/dev/mailbox).
EMAIL_FROM="RetrainWise <onboarding@resend.dev>"

# Python engine interpreter (optional; auto-detected otherwise)
RETRAINWISE_PYTHON=""

# Comma-separated host names allowed to call the API besides localhost
# (set this when deploying behind a domain, e.g. "retrainwise.example.com").
RETRAINWISE_ALLOWED_HOSTS=""

# Open-source models for the advisory agent through an OpenAI-compatible
# endpoint (Groq, OpenRouter, Together, Hugging Face, ...). Choose the endpoint
# and model in Agent & audit; the key stays here and is never stored in the app.
LLM_API_KEY=""

# Where the public contact form delivers messages.
CONTACT_EMAIL=""
