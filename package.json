{
  "name": "retrainwise",
  "version": "3.0.0",
  "private": true,
  "description": "Lifecycle-aware ML decision system: Next.js dashboard over a Python lifecycle engine with SQLite as the source of truth.",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "node scripts/setup-env.mjs && node scripts/check-python.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/setup-env.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup:python": "node scripts/setup-python.mjs",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "test": "npm run typecheck && npm run test:engine"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.0",
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.10",
    "prisma": "^6.19.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
