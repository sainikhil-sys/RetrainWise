  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "playwright-core": "1.55.1",
    "tsx": "4.23.15",
