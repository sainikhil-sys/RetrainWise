{
  "name": "retrainwise",
  "version": "2.0.0",
  "private": true,
  "description": "Lifecycle-aware ML decision system: Next.js dashboard over a Python lifecycle engine with SQLite as the source of truth.",
  "scripts": {
    "predev": "node scripts/check-python.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup:python": "node scripts/setup-python.mjs",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "test": "npm run typecheck && npm run test:engine"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
